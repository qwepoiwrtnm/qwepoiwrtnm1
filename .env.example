# =====================================================================
# Cutie Client <3 — environment configuration
# Copy to `.env` and fill in. Never commit real secrets.
#
# Client-exposed values MUST use the VITE_ prefix (they ship in the
# browser bundle). Everything else is server-only.
# =====================================================================

# ---------- Public / client-side (all OPTIONAL, safe defaults exist) ----------
VITE_SITE_URL=
VITE_SUPPORT_EMAIL=

# Trusted installer URLs. When empty the UI shows a development-mode notice
# instead of a broken link. Download links are NEVER taken from query params.
VITE_WINDOWS_DOWNLOAD_URL=
VITE_MACOS_DOWNLOAD_URL=

VITE_WINDOWS_VERSION=
VITE_MACOS_VERSION=
VITE_WINDOWS_FILE_SIZE=
VITE_MACOS_FILE_SIZE=

# SHA-256 checksums. Leave empty unless you have the real value —
# the checksum block is hidden entirely when unset.
VITE_WINDOWS_SHA256=
VITE_MACOS_SHA256=

VITE_LAST_UPDATED=
VITE_RELEASE_NOTES_URL=

# JSON endpoint returning { "services": [{ id, name, description, status }] }
VITE_STATUS_API_URL=

# Optional hero video (e.g. /video/hero.mp4). Poster falls back to the hero image.
VITE_HERO_VIDEO_URL=

# Optional privacy-respecting analytics script URL. Nothing loads when empty.
VITE_ANALYTICS_SRC=

# ---------- Server-only (REQUIRED to enable optional accounts) ----------
# Long random string, e.g. `openssl rand -base64 48`
AUTH_SECRET=
# PostgreSQL connection string
AUTH_DATABASE_URL=

# ---------- Server-only (REQUIRED for verification / reset / support email) ----------
RESEND_API_KEY=
EMAIL_FROM=
SUPPORT_EMAIL=
